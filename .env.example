# ─────────────────────────────────────────────────────────────────────────────
# Variables del servidor. Solo secretos e infraestructura: todo lo demás
# (textos, precios, @usuario, canal, avisos…) se configura desde el panel.
# En Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la app (https en producción). Es también la URL de la MiniApp.
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# Supabase → Project Settings → API. La service_role NUNCA en el navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Token del bot que te da @BotFather.
TELEGRAM_BOT_TOKEN=

# Clave que Telegram manda en cada webhook. Solo letras, números, _ y - (mín. 16).
# Genera una con:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Contraseña del panel (mín. 10 caracteres). Cámbiala si alguien la ve.
ADMIN_PASSWORD=

# Clave para firmar las sesiones del panel (mín. 32). openssl rand -hex 32
SESSION_SECRET=

# Clave del programador (mín. 16). Vercel la envía sola en su cron diario.
CRON_SECRET=

# Opcional: validez de la sesión de la MiniApp en segundos (60–86400).
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
