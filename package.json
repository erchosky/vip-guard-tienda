{
  "name": "vip-guard-tienda",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "bash scripts/test-sql.sh",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:sql && npm run build",
    "local:stack": "node scripts/local-stack.mjs",
    "local:dev": "bash -c \"set -a && source .local/env && set +a && next dev\"",
    "db:push": "supabase db push",
    "zip:clean": "bash scripts/zip-clean.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "clsx": "2.1.1",
    "grammy": "1.44.0",
    "lucide-react": "0.468.0",
    "next": "15.5.26",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "supabase": "2.109.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
